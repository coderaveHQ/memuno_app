# Supabase local development environment variables

# SMTP password for auth.email.smtp (used by supabase/config.toml)
SMTP_PASSWORD=

# Edge Function runtime secrets (new key model)
# Obtain local values from: supabase status -o env
SB_PUBLISHABLE_KEY=
SB_SECRET_KEY=

# Firebase Cloud Messaging service account JSON
# Keep this as one-line JSON string with escaped newlines (\n) in private_key.
# Generated by: jq -c . /path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# [DEVELOPMENT ONLY]
# Optional device-reachable base URL used to rebase push image signed links.
# Example: http://192.168.188.114:54321
PUSH_IMAGE_PUBLIC_BASE_URL=
